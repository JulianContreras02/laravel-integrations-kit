APP_NAME="Integrations Kit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Signed download links in emails point here; keep it in line with APP_PORT.
APP_URL=http://localhost:8000

# Host ports published by docker compose. Change any that are taken.
APP_PORT=8000
S3_PORT=9000
S3_CONSOLE_PORT=9001
SFTP_PORT=2222
PARTNER_API_PORT=8080
MAILPIT_PORT=8025

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Holds the partner's OAuth token and its refresh lock, so it must be shared by
# every worker. "file" is enough on one host; use redis or dynamodb when workers
# run on several hosts or on Lambda.
CACHE_STORE=file
# CACHE_PREFIX=

# -----------------------------------------------------------------------------
# Everything below points at the docker compose services. The credentials are
# throwaway values for those local containers, never real ones. In production
# they come from a secrets manager, not from a file.
# -----------------------------------------------------------------------------

# Mailpit (web UI: http://localhost:8025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="reports@shop.example"
MAIL_FROM_NAME="${APP_NAME}"

# RustFS, S3-compatible (console: http://localhost:9001)
AWS_ACCESS_KEY_ID=local-access-key
AWS_SECRET_ACCESS_KEY=local-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=reports
AWS_ENDPOINT=http://s3:9000
# Host the browser uses to download presigned URLs. Empty means same as AWS_ENDPOINT.
AWS_PUBLIC_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# The partner's SFTP drop box
PARTNER_SFTP_HOST=sftp
PARTNER_SFTP_PORT=22
PARTNER_SFTP_USERNAME=partner
PARTNER_SFTP_PASSWORD=local-sftp-password
PARTNER_SFTP_ROOT=/inbound

# The partner's API and its OAuth2 token endpoint (WireMock)
PARTNER_API_URL=http://partner-api:8080
PARTNER_OAUTH_TOKEN_URL=http://partner-api:8080/oauth/token
PARTNER_OAUTH_CLIENT_ID=local-client-id
PARTNER_OAUTH_CLIENT_SECRET=local-client-secret
PARTNER_OAUTH_SCOPE=reports:write

# The daily report
REPORT_TIMEZONE=America/Bogota
REPORT_MAIL_TO=ops@partner.example
# Whole-message ceiling after base64. 10 MB matches SES v1; lower it to see
# the signed-link email with a small report.
REPORT_MAIL_MAX_MESSAGE_BYTES=10000000
