{
    "mappings": [
        {
            "name": "OAuth2 token: valid client credentials",
            "priority": 1,
            "request": {
                "method": "POST",
                "urlPath": "/oauth/token",
                "basicAuthCredentials": {
                    "username": "local-client-id",
                    "password": "local-client-secret"
                },
                "bodyPatterns": [
                    { "contains": "grant_type=client_credentials" }
                ]
            },
            "response": {
                "status": 200,
                "headers": {
                    "Content-Type": "application/json",
                    "Cache-Control": "no-store"
                },
                "jsonBody": {
                    "access_token": "{{randomValue length=40 type='ALPHANUMERIC'}}",
                    "token_type": "Bearer",
                    "expires_in": 3600,
                    "scope": "reports:write"
                }
            }
        },
        {
            "name": "OAuth2 token: anything else is an invalid client",
            "priority": 10,
            "request": {
                "method": "POST",
                "urlPath": "/oauth/token"
            },
            "response": {
                "status": 401,
                "headers": {
                    "Content-Type": "application/json",
                    "WWW-Authenticate": "Basic realm=\"partner\""
                },
                "jsonBody": { "error": "invalid_client" }
            }
        }
    ]
}
